<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SEALS Pharmaceutical - Trusted Online Pharmacy</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-900">

    <!-- Header -->
    <header class="bg-white shadow p-4 flex justify-between items-center">
        <!-- SEALS Logo -->
        <div class="flex items-center space-x-2">
            <div class="bg-blue-600 text-white px-3 py-1 rounded-full text-xl font-extrabold">SEALS</div>
            <span class="text-lg font-semibold text-blue-600">Pharmaceutical</span>
        </div>
        <nav class="space-x-4 text-sm md:text-base">
            <a href="#" class="hover:text-blue-600">Home</a>
            <a href="#products" class="hover:text-blue-600">Products</a>
            <a href="#order" class="hover:text-blue-600">Order</a>
            <a href="#contact" class="hover:text-blue-600">Contact</a>
        </nav>
    </header>

    <!-- Hero -->
    <section class="text-center py-16 bg-blue-100">
        <h2 class="text-3xl md:text-5xl font-bold mb-4">Order Genuine Drugs Easily</h2>
        <p class="text-md md:text-lg mb-6">Affordable. Fast. Trusted. From SEALS Pharmaceutical.</p>
        <a href="#order" class="bg-blue-600 text-white px-6 py-3 rounded hover:bg-blue-700 transition">Place an Order</a>
    </section>

    <!-- Products -->
    <section id="products" class="py-12 px-6 max-w-5xl mx-auto">
        <h3 class="text-2xl font-bold mb-6 text-center">Our Products</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <div class="border p-4 rounded shadow bg-white text-center">
                <h4 class="font-bold mb-2">Paracetamol Full Pack</h4>
                <p>₦4,000 | ~$4.28</p>
            </div>

            <div class="border p-4 rounded shadow bg-white text-center">
                <h4 class="font-bold mb-2">Ibuprofen Full Pack</h4>
                <p>₦9,000 | ~$9.62</p>
            </div>

            <div class="border p-4 rounded shadow bg-white text-center">
                <h4 class="font-bold mb-2">Vitamin C Full Pack</h4>
                <p>₦1,500 | ~$1.60</p>
            </div>

        </div>
    </section>

    <!-- Order Form -->
    <section id="order" class="py-12 px-6 bg-white max-w-3xl mx-auto shadow rounded mt-6">
        <h3 class="text-2xl font-bold mb-4 text-center">Place an Order</h3>
        <form id="orderForm" class="space-y-4">
            <input type="text" placeholder="Full Name" class="w-full border p-2 rounded" required>
            <input type="text" placeholder="Delivery Address" class="w-full border p-2 rounded" required>
            <input type="tel" placeholder="Phone Number" class="w-full border p-2 rounded" required>
            <select id="productSelect" class="w-full border p-2 rounded" required>
                <option value="">Select Product</option>
                <option value="Paracetamol Full Pack">Paracetamol Full Pack - ₦4,000</option>
                <option value="Ibuprofen Full Pack">Ibuprofen Full Pack - ₦9,000</option>
                <option value="Vitamin C Full Pack">Vitamin C Full Pack - ₦1,500</option>
            </select>
            <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 w-full">Proceed</button>
        </form>
    </section>

    <!-- Payment Info -->
    <section id="paymentDetails" class="hidden py-6 px-4 bg-green-50 max-w-3xl mx-auto rounded shadow text-center mt-6">
        <h3 class="text-xl font-bold mb-2">Payment Instructions</h3>
        <p class="mb-2">Pay to: <strong>SHEDRACK LUKPATA ULAKOM</strong></p>
        <p class="mb-2">Bank: <strong>PALMPAY</strong></p>
        <p class="mb-2">Account Number: <strong>8164269736</strong></p>
        <p class="mb-2">Phone (After Payment): <strong>08164269736</strong></p>
        <p class="mt-4 text-green-700 font-semibold">Send payment confirmation via WhatsApp or call after payment.</p>
    </section>

    <!-- Contact -->
    <section id="contact" class="py-12 text-center">
        <h3 class="text-2xl font-bold mb-2">Need Help?</h3>
        <p>Email: info@sealspharma.com | WhatsApp/Call: 08164269736</p>
        <p class="text-sm text-gray-500 mt-1">We are available 24/7 to assist you</p>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-200 text-center py-4 mt-8">
        <p>&copy; 2025 SEALS Pharmaceutical. All rights reserved.</p>
    </footer>

    <script>
        const conversionRate = 0.00107;
        const products = {
            "Paracetamol Full Pack": 4000,
            "Ibuprofen Full Pack": 9000,
            "Vitamin C Full Pack": 1500
        };

        document.getElementById("orderForm").addEventListener("submit", function(e) {
            e.preventDefault();
            const product = document.getElementById("productSelect").value;
            if (!product) return alert("Please select a product");
            document.getElementById("paymentDetails").classList.remove("hidden");
            window.scrollTo(0, document.getElementById("paymentDetails").offsetTop);
        });
    </script>

</body>

</html>
